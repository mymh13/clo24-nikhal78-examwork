@page "/test-bookings"
@using System.Net.Http.Json
@using System.Text.Json
@using Ticketing.Contracts.Bookings
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Test Bookings API</PageTitle>

<div class="container">
    <h1>Test Bookings API</h1>

    @if (!isAuthenticated)
    {
        <p>Please <a href="/login">log in</a> first.</p>
        return;
    }

    <div style="margin: 20px 0;">
        <h3>Create Booking (POST)</h3>
        <form @onsubmit="CreateBooking" @onsubmit:preventDefault="true">
            <div style="margin: 10px 0;">
                <label>Customer ID:</label>
                <input @bind="newBooking.CustomerId" style="margin-left: 10px; padding: 5px;" />
            </div>
            <div style="margin: 10px 0;">
                <label>Customer Name:</label>
                <input @bind="newBooking.CustomerName" style="margin-left: 10px; padding: 5px;" />
            </div>
            <button type="submit" class="btn btn-primary">Create Booking</button>
        </form>
        @if (!string.IsNullOrEmpty(createResult))
        {
            <pre style="background: #1e1e1e; padding: 10px; border-radius: 4px; margin-top: 10px;">@createResult</pre>
        }
    </div>

    <hr />

    <div style="margin: 20px 0;">
        <h3>Get Bookings by Customer (GET)</h3>
        <form @onsubmit="GetBookings" @onsubmit:preventDefault="true">
            <div style="margin: 10px 0;">
                <label>Customer ID:</label>
                <input @bind="searchCustomerId" style="margin-left: 10px; padding: 5px;" />
            </div>
            <button type="submit" class="btn btn-primary">Get Bookings</button>
        </form>
        @if (!string.IsNullOrEmpty(getResult))
        {
            <pre style="background: #1e1e1e; padding: 10px; border-radius: 4px; margin-top: 10px;">@getResult</pre>
        }
    </div>
</div>

@code {
    private bool isAuthenticated = false;
    private Booking newBooking = new();
    private string searchCustomerId = string.Empty;
    private string createResult = string.Empty;
    private string getResult = string.Empty;

    protected override void OnInitialized()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        isAuthenticated = user?.Identity?.IsAuthenticated == true;
    }

    private async Task CreateBooking()
    {
        createResult = "Creating...";
        try
        {
            var response = await Http.PostAsJsonAsync("/api/bookings", newBooking);
            var content = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                createResult = $"Success ({response.StatusCode}):\n{content}";
                newBooking = new Booking(); // Reset form
            }
            else
            {
                createResult = $"Error ({response.StatusCode}):\n{content}";
            }
        }
        catch (Exception ex)
        {
            createResult = $"Exception: {ex.Message}";
        }
    }

    private async Task GetBookings()
    {
        getResult = "Loading...";
        try
        {
            var response = await Http.GetAsync($"/api/bookings/customer/{searchCustomerId}");
            var content = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                getResult = $"Success ({response.StatusCode}):\n{content}";
            }
            else
            {
                getResult = $"Error ({response.StatusCode}):\n{content}";
            }
        }
        catch (Exception ex)
        {
            getResult = $"Exception: {ex.Message}";
        }
    }
}

