@page "/user"
@using System.Net.Http.Json
@using System.Security.Claims
@using Ticketing.Contracts.Bookings
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "User")]
@inject IHttpContextAccessor HttpContextAccessor
@inject HttpClient Http

<PageTitle>User Dashboard</PageTitle>

<div class="container">
    <h1>User Dashboard</h1>
    
    @{
        var user = HttpContextAccessor.HttpContext?.User;
        var userId = user?.FindFirstValue(ClaimTypes.NameIdentifier) ?? user?.FindFirstValue(ClaimTypes.Email);
    }
    
    @if (user?.Identity?.IsAuthenticated == true)
    {
        <div class="user-info">
            <div class="user-info-text">
                <p><strong>Authenticated as:</strong> @user.Identity.Name</p>
                <p><strong>Email:</strong> @user.FindFirstValue(ClaimTypes.Email)</p>
            </div>
            <form method="post" action="/api/auth/logout" class="user-info-logout">
                <button type="submit" class="btn btn-secondary">Logout</button>
            </form>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>My Information:</strong> View and update your account information.</p>
                <p style="color: var(--color-text-muted); font-size: 0.9em; margin-top: var(--spacing-sm);">
                    Account information management will be implemented in a later step.
                </p>
            </div>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>My Tickets:</strong> View and create your own tickets.</p>
                
                <div style="margin-top: var(--spacing-lg);">
                    <h3 style="font-size: 1.2em; margin-bottom: var(--spacing-md);">My Existing Tickets</h3>
                    @if (myBookings == null)
                    {
                        <p>Loading tickets...</p>
                    }
                    else if (myBookings.Any())
                    {
                        <div class="bookings-table-container" style="margin-bottom: var(--spacing-xl);">
                            <table class="bookings-table">
                                <thead>
                                    <tr>
                                        <th>Booking ID</th>
                                        <th>Zone</th>
                                        <th>Status</th>
                                        <th>Price Modifier</th>
                                        <th>Total Price</th>
                                        <th>Booking Date</th>
                                        <th>Validity Period</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in myBookings)
                                    {
                                        <tr>
                                            <td>@booking.Id</td>
                                            <td>@(string.IsNullOrEmpty(booking.Zone) ? "-" : booking.Zone)</td>
                                            <td>
                                                @{
                                                    var statusClass = booking.Status switch
                                                    {
                                                        "Created" => "status-badge status-created",
                                                        "Activated" => "status-badge status-activated",
                                                        "Valid" => "status-badge status-valid",
                                                        "Expired" => "status-badge status-expired",
                                                        _ => "status-badge"
                                                    };
                                                }
                                                <span class="@statusClass">@booking.Status</span>
                                            </td>
                                            <td>@(booking.PriceModifier == 0.0m ? "Free (Child)" : booking.PriceModifier == 0.5m ? "50% (Student/Pensioner)" : "100% (Standard)")</td>
                                            <td>@booking.TotalPrice.ToString("F2") SEK (@booking.BasePrice.ToString("F2") SEK base)</td>
                                            <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>
                                                @if (booking.ActivatedAt.HasValue && booking.ValidTo.HasValue)
                                                {
                                                    <div style="font-size: 0.9em;">
                                                        <div><strong>Activated:</strong> @booking.ActivatedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                                        <div><strong>Valid until:</strong> @booking.ValidTo.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                                        @if (booking.ValidTo.Value < DateTime.UtcNow)
                                                        {
                                                            <div style="color: #f44336; font-weight: bold;">Expired</div>
                                                        }
                                                        else
                                                        {
                                                            var timeRemaining = booking.ValidTo.Value - DateTime.UtcNow;
                                                            <div style="color: #4caf50;">@((int)timeRemaining.TotalMinutes) minutes remaining</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--color-text-muted);">Not activated</span>
                                                }
                                            </td>
                                            <td>
                                                @if (booking.Status == TicketStatus.Created)
                                                {
                                                    <button class="btn btn-primary btn-sm" @onclick="() => ActivateTicket(booking.Id)" disabled="@(activatingBookingId == booking.Id)">
                                                        @if (activatingBookingId == booking.Id)
                                                        {
                                                            <text>Activating...</text>
                                                        }
                                                        else
                                                        {
                                                            <text>Activate Ticket</text>
                                                        }
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--color-text-muted); font-size: 0.9em;">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="info-message" style="margin-bottom: var(--spacing-xl);">
                            <p>You don't have any tickets yet. Create your first ticket below.</p>
                        </div>
                    }
                    
                    <h3 style="font-size: 1.2em; margin-bottom: var(--spacing-md); margin-top: var(--spacing-xl);">Create New Ticket</h3>
                    <form @onsubmit="CreateTicket" @onsubmit:preventDefault="true" class="booking-form" style="max-width: 500px; margin: 0 auto;">
                        <div class="form-group">
                            <label>Your Name:</label>
                            <input type="text" value="@(user?.Identity?.Name ?? user?.FindFirstValue(ClaimTypes.Email) ?? "")" class="form-input" disabled style="opacity: 0.7; cursor: not-allowed;" />
                            <small style="color: var(--color-text-muted); font-size: 0.85em; margin-top: 5px; display: block;">
                                Your name is taken from your account and cannot be changed here.
                            </small>
                        </div>
                        <div class="form-group">
                            <label>Zones (select one or more):</label>
                            <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); margin-top: 8px;">
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" checked="@userSelectedZones.Contains("Zone A")" @onchange="@(() => ToggleZone("Zone A"))" />
                                    <span>Zone A</span>
                                </label>
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" checked="@userSelectedZones.Contains("Zone B")" @onchange="@(() => ToggleZone("Zone B"))" />
                                    <span>Zone B</span>
                                </label>
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" checked="@userSelectedZones.Contains("Zone C")" @onchange="@(() => ToggleZone("Zone C"))" />
                                    <span>Zone C</span>
                                </label>
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" checked="@userSelectedZones.Contains("Zone D")" @onchange="@(() => ToggleZone("Zone D"))" />
                                    <span>Zone D</span>
                                </label>
                            </div>
                            <small style="color: var(--color-text-muted); font-size: 0.85em; margin-top: 5px; display: block;">
                                Each zone costs 20 SEK. Price is calculated based on your age and student status. Total: @(userSelectedZones.Count * 20) SEK base price.
                            </small>
                        </div>
                        <button type="submit" class="btn btn-primary">Create Ticket</button>
                    </form>
                    @if (!string.IsNullOrEmpty(ticketResult))
                    {
                        <div class="@(ticketResult.StartsWith("Success") ? "success-message" : "error-message")" style="margin-top: var(--spacing-md);">
                            <p>@ticketResult</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(activationResult))
                    {
                        <div class="@(activationResult.StartsWith("Success") ? "success-message" : "error-message")" style="margin-top: var(--spacing-md);">
                            <p>@activationResult</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <p>Not authenticated. <a href="/login">Go to login page</a> to authenticate.</p>
    }
</div>

@code {
    private Booking newTicket = new();
    private List<string> userSelectedZones = new();
    private string ticketResult = string.Empty;
    private string activationResult = string.Empty;
    private List<Booking>? myBookings = null;
    private string? activatingBookingId = null;

    private void ToggleZone(string zone)
    {
        if (userSelectedZones.Contains(zone))
        {
            userSelectedZones.Remove(zone);
        }
        else
        {
            userSelectedZones.Add(zone);
        }
        // Update the ticket's Zone property with comma-separated list
        newTicket.Zone = string.Join(", ", userSelectedZones);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMyBookings();
    }

    private async Task LoadMyBookings()
    {
        try
        {
            var response = await Http.GetAsync("/api/bookings/my-bookings");
            
            if (response.IsSuccessStatusCode)
            {
                myBookings = await response.Content.ReadFromJsonAsync<List<Booking>>();
            }
        }
        catch
        {
            // Silently fail - tickets will just not be displayed
            myBookings = new List<Booking>();
        }
    }

    private async Task CreateTicket()
    {
        ticketResult = string.Empty;

        // Validate that at least one zone is selected
        if (userSelectedZones.Count == 0)
        {
            ticketResult = "Error: Please select at least one zone.";
            return;
        }

        try
        {
            // Create booking with selected zones - controller will fill in user's actual data
            var bookingToCreate = new Booking
            {
                CustomerEmail = string.Empty, // Will be set by controller from user's claims
                CustomerName = string.Empty,  // Will be set by controller from user's account
                Zone = string.Join(", ", userSelectedZones)
            };
            
            var response = await Http.PostAsJsonAsync("/api/bookings", bookingToCreate);
            
            if (response.IsSuccessStatusCode)
            {
                ticketResult = "Success: Ticket created successfully!";
                newTicket = new Booking(); // Reset form
                userSelectedZones.Clear(); // Reset zone selection
                await LoadMyBookings(); // Refresh ticket list
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ticketResult = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            ticketResult = $"Error: An error occurred when trying to create the ticket. {ex.Message}";
        }
    }

    private async Task ActivateTicket(string bookingId)
    {
        activationResult = string.Empty;
        activatingBookingId = bookingId;

        try
        {
            var response = await Http.PostAsJsonAsync($"/api/bookings/{bookingId}/activate", new { });

            if (response.IsSuccessStatusCode)
            {
                activationResult = "Success: Ticket activated successfully!";
                await LoadMyBookings(); // Refresh ticket list to show updated status
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                activationResult = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            activationResult = $"Error: An error occurred when trying to activate the ticket. {ex.Message}";
        }
        finally
        {
            activatingBookingId = null;
        }
    }
}

