    private string GetTableDisplayName(QueryTable table)
    {
        if (table == null) return "Unknown Table";

        // Check table name and columns to determine display name
        if (table.Name == "PrimaryResult")
        {
            var columnNames = table.Columns?.Select(c => c.Name ?? "").ToList() ?? new List<string>();
            
            if (columnNames.Contains("name") && columnNames.Contains("Count"))
            {
                return "Custom Events Summary";
            }
            else if (columnNames.Any(c => c.Contains("timestamp", StringComparison.OrdinalIgnoreCase)))
            {
                return "Event Logs & Query Statistics";
            }
            else
            {
                return "Query Results";
            }
        }
        else if (table.Name.Contains("QueryResult", StringComparison.OrdinalIgnoreCase) || 
                 table.Name.Contains("QueryProperties", StringComparison.OrdinalIgnoreCase) || 
                 table.Name.Contains("QueryStatus", StringComparison.OrdinalIgnoreCase))
        {
            return "Query Metadata";
        }

        return table.Name;
    }

    private string GetColumnDisplayName(string columnName)
    {
        if (string.IsNullOrEmpty(columnName)) return columnName;

        // Map common Application Insights column names to descriptive headers
        var columnMappings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            // Timestamp columns
            { "timestamp", "Event Timestamp" },
            { "Timestamp", "Event Timestamp" },
            
            // Log level/type columns
            { "Level", "Log Level" },
            { "level", "Log Level" },
            { "Type", "Event Type" },
            { "type", "Event Type" },
            { "Severity", "Severity Level" },
            { "severity", "Severity Level" },
            
            // Message/description columns
            { "Message", "Event Message" },
            { "message", "Event Message" },
            { "Description", "Description" },
            { "description", "Description" },
            
            // Count/numeric columns
            { "Count", "Event Count" },
            { "count", "Event Count" },
            { "Value", "Value" },
            { "value", "Value" },
            
            // Event name columns
            { "name", "Event Name" },
            { "Name", "Event Name" },
            { "EventName", "Event Name" },
            { "eventName", "Event Name" },
            
            // Query execution columns
            { "QueryHash", "Query Hash" },
            { "queryHash", "Query Hash" },
            { "ExecutionTime", "Execution Time (ms)" },
            { "executionTime", "Execution Time (ms)" },
            
            // ID columns
            { "Id", "Identifier" },
            { "id", "Identifier" },
            { "BookingId", "Booking ID" },
            { "bookingId", "Booking ID" },
            { "EventId", "Event ID" },
            { "eventId", "Event ID" },
            { "CustomerId", "Customer ID" },
            { "customerId", "Customer ID" },
            { "OutboxEventId", "Outbox Event ID" },
            { "outboxEventId", "Outbox Event ID" },
            
            // System type columns
            { "SystemType", "System Type" },
            { "systemType", "System Type" },
            { "ArchitectureMode", "Architecture Mode" },
            { "architectureMode", "Architecture Mode" },
            
            // Query metadata columns
            { "QueryResult", "Result Type" },
            { "queryResult", "Result Type" },
            { "QueryProperties", "Property Type" },
            { "queryProperties", "Property Type" },
            { "QueryStatus", "Status" },
            { "queryStatus", "Status" },
            { "PrimaryResult", "Primary Result" },
            { "primaryResult", "Primary Result" },
            { "@ExtendedProperties", "Extended Properties" },
            
            // Index/position columns
            { "Index", "Row Index" },
            { "index", "Row Index" },
            { "Position", "Position" },
            { "position", "Position" },
            
            // Resource usage columns
            { "resource_usage", "Resource Usage" },
            { "ResourceUsage", "Resource Usage" },
            { "input_dataset_statistics", "Dataset Statistics" },
            { "InputDatasetStatistics", "Dataset Statistics" }
        };

        // Check for exact match first
        if (columnMappings.TryGetValue(columnName, out var displayName))
        {
            return displayName;
        }

        // Check for partial matches (e.g., columns containing certain keywords)
        var lowerColumnName = columnName.ToLowerInvariant();
        
        if (lowerColumnName.Contains("timestamp") || lowerColumnName.Contains("time"))
            return "Timestamp";
        if (lowerColumnName.Contains("id") && !lowerColumnName.Contains("guid"))
            return "ID";
        if (lowerColumnName.Contains("guid"))
            return "GUID";
        if (lowerColumnName.Contains("email"))
            return "Email Address";
        if (lowerColumnName.Contains("name"))
            return "Name";
        if (lowerColumnName.Contains("count"))
            return "Count";
        if (lowerColumnName.Contains("price") || lowerColumnName.Contains("cost"))
            return "Price";
        if (lowerColumnName.Contains("status"))
            return "Status";
        if (lowerColumnName.Contains("type"))
            return "Type";
        if (lowerColumnName.Contains("mode"))
            return "Mode";

        // Default: return original name with proper casing
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(columnName.Replace("_", " "));
    }

    private string GetColumnDescription(string columnName, string tableName)
    {
        if (string.IsNullOrEmpty(columnName)) return string.Empty;

        var descriptions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "timestamp", "The date and time when the event occurred (UTC)" },
            { "Level", "The severity level of the log entry (Info, Warning, Error, etc.)" },
            { "Type", "The type or category of the event" },
            { "Message", "A descriptive message about what happened" },
            { "Count", "The number of occurrences of this event" },
            { "name", "The name of the custom event (e.g., BookingCreated, OutboxEventProcessed)" },
            { "QueryHash", "A unique hash identifier for the query execution" },
            { "ExecutionTime", "How long the query took to execute in milliseconds" },
            { "BookingId", "Unique identifier for a booking/ticket" },
            { "EventId", "Unique identifier for an event" },
            { "CustomerId", "Unique identifier for a customer/user" },
            { "SystemType", "Whether the event was processed in Synchronous or Event-Driven mode" },
            { "ArchitectureMode", "The architecture mode active when the event occurred" },
            { "QueryResult", "The type of query result (PrimaryResult, QueryProperties, etc.)" },
            { "Index", "The position of this row in the result set" }
        };

        if (descriptions.TryGetValue(columnName, out var description))
        {
            return description;
        }

        return $"Column: {GetColumnDisplayName(columnName)}";
    }

    private class StaticTableDefinition
    {
        public string Description { get; set; } = string.Empty;
        public List<StaticColumnDefinition> Columns { get; set; } = new();
    }

    private class StaticColumnDefinition
    {
        public string OriginalName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int OriginalIndex { get; set; } = -1; // Index in the original table
    }

    private StaticTableDefinition GetStaticTableDefinition(QueryTable table)
    {
        if (table == null || table.Columns == null) 
        {
            return new StaticTableDefinition { Description = "Unknown Table" };
        }

        var columnNames = table.Columns.Select(c => c.Name ?? "").ToList();

        // Table 1: Custom Events Summary (name, Count)
        if (columnNames.Contains("name") && columnNames.Contains("Count"))
        {
            var columns = new List<StaticColumnDefinition>();
            for (int i = 0; i < table.Columns.Count; i++)
            {
                var col = table.Columns[i];
                var colName = col.Name ?? "";
                var lowerName = colName.ToLowerInvariant();
                
                if (lowerName == "name")
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Event Name", 
                        Description = "The name of the custom event (e.g., BookingCreated, OutboxEventProcessed, ServiceBusEventPublished)" 
                    });
                }
                else if (colName == "Count")
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Event Count", 
                        Description = "The total number of times this event occurred in the last hour" 
                    });
                }
                else
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = GetColumnDisplayName(colName), 
                        Description = GetColumnDescription(colName, table.Name) 
                    });
                }
            }
            
            return new StaticTableDefinition
            {
                Description = "Custom Events Summary - Shows count of each event type from the last hour",
                Columns = columns
            };
        }

        // Table 2: Event Logs with timestamps (complex table with many columns)
        if (columnNames.Any(c => c.Contains("timestamp", StringComparison.OrdinalIgnoreCase)))
        {
            var columns = new List<StaticColumnDefinition>();
            
            // Map known columns - preserve original order
            for (int i = 0; i < table.Columns.Count; i++)
            {
                var col = table.Columns[i];
                var colName = col.Name ?? "";
                var lowerName = colName.ToLowerInvariant();
                
                if (lowerName.Contains("timestamp"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Event Timestamp", 
                        Description = "The date and time when the event occurred (UTC)" 
                    });
                }
                else if (lowerName == "level" || lowerName.Contains("severity"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Log Level", 
                        Description = "The severity level of the log entry (Info, Warning, Error, etc.)" 
                    });
                }
                else if (lowerName == "type")
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Event Type", 
                        Description = "The type or category of the event (Info, Stats, etc.)" 
                    });
                }
                else if (lowerName.Contains("message") || lowerName.Contains("description"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Event Message", 
                        Description = "A descriptive message about what happened or query execution details" 
                    });
                }
                else if (lowerName.Contains("queryhash"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Query Hash", 
                        Description = "A unique hash identifier for the query execution" 
                    });
                }
                else if (lowerName.Contains("executiontime"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Execution Time", 
                        Description = "How long the query took to execute in milliseconds" 
                    });
                }
                else if (lowerName.Contains("resource_usage") || lowerName.Contains("dataset"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Query Statistics", 
                        Description = "Detailed query execution statistics including resource usage and dataset information (JSON format)" 
                    });
                }
                else if (lowerName.Contains("id") && !lowerName.Contains("guid"))
                {
                    var displayName = colName.Contains("Booking") ? "Booking ID" :
                                     colName.Contains("Event") ? "Event ID" :
                                     colName.Contains("Customer") ? "Customer ID" :
                                     colName.Contains("Outbox") ? "Outbox Event ID" :
                                     "Identifier";
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = displayName, 
                        Description = $"Unique identifier: {colName}" 
                    });
                }
                else if (lowerName.Contains("guid"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "GUID", 
                        Description = "Globally unique identifier" 
                    });
                }
                else
                {
                    // Default mapping
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = GetColumnDisplayName(colName), 
                        Description = GetColumnDescription(colName, table.Name) 
                    });
                }
            }

            return new StaticTableDefinition
            {
                Description = "Event Logs & Query Statistics - Detailed event information with timestamps, log levels, and query execution statistics",
                Columns = columns
            };
        }

        // Table 3: Query Metadata (QueryResult, QueryProperties, QueryStatus)
        if (table.Name.Contains("QueryResult", StringComparison.OrdinalIgnoreCase) || 
            table.Name.Contains("QueryProperties", StringComparison.OrdinalIgnoreCase) || 
            table.Name.Contains("QueryStatus", StringComparison.OrdinalIgnoreCase))
        {
            var columns = new List<StaticColumnDefinition>();
            
            for (int i = 0; i < table.Columns.Count; i++)
            {
                var col = table.Columns[i];
                var colName = col.Name ?? "";
                var lowerName = colName.ToLowerInvariant();
                
                if (lowerName.Contains("index") || lowerName == "0" || colName == "0")
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Row Index", 
                        Description = "The position of this row in the result set (0-based)" 
                    });
                }
                else if (lowerName.Contains("queryresult"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Result Type", 
                        Description = "The type of query result (PrimaryResult, QueryProperties, QueryStatus)" 
                    });
                }
                else if (lowerName.Contains("queryproperties") || lowerName.Contains("extended"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Property Type", 
                        Description = "Extended properties or metadata about the query" 
                    });
                }
                else if (lowerName.Contains("querystatus"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Status", 
                        Description = "The status of the query execution" 
                    });
                }
                else if (lowerName.Contains("primaryresult"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Primary Result", 
                        Description = "The main result identifier" 
                    });
                }
                else if (lowerName.Contains("guid") || lowerName.Contains("id"))
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = "Identifier", 
                        Description = "Unique identifier for this query result" 
                    });
                }
                else
                {
                    columns.Add(new StaticColumnDefinition 
                    { 
                        OriginalName = colName,
                        OriginalIndex = i,
                        DisplayName = GetColumnDisplayName(colName), 
                        Description = GetColumnDescription(colName, table.Name) 
                    });
                }
            }

            return new StaticTableDefinition
            {
                Description = "Query Metadata - Information about the query execution and result structure",
                Columns = columns
            };
        }

        // Fallback: Use dynamic mapping - preserve original order
        var fallbackColumns = new List<StaticColumnDefinition>();
        for (int i = 0; i < table.Columns.Count; i++)
        {
            var col = table.Columns[i];
            fallbackColumns.Add(new StaticColumnDefinition
            {
                OriginalName = col.Name ?? "",
                OriginalIndex = i,
                DisplayName = GetColumnDisplayName(col.Name ?? ""),
                Description = GetColumnDescription(col.Name ?? "", table.Name)
            });
        }

        // Try to determine a better description based on table name
        string tableDescription = "Data Table";
        var lowerTableName = (table.Name ?? "").ToLowerInvariant();
        if (lowerTableName.Contains("primaryresult") || lowerTableName.Contains("primary"))
        {
            tableDescription = "Primary Query Results - Main data returned from the Application Insights query";
        }
        else if (lowerTableName.Contains("queryproperties"))
        {
            tableDescription = "Query Properties - Extended metadata about the query execution";
        }
        else if (lowerTableName.Contains("querystatus"))
        {
            tableDescription = "Query Status - Status information about the query execution";
        }
        else if (lowerTableName.Contains("custom") || lowerTableName.Contains("event"))
        {
            tableDescription = "Custom Events - Application Insights custom event data";
        }
        else
        {
            tableDescription = $"Data Table: {GetTableDisplayName(table)}";
        }

        return new StaticTableDefinition
        {
            Description = tableDescription,
            Columns = fallbackColumns
        };
    }

    private string GetCellValue(List<object?> row, StaticColumnDefinition colDef)
    {
        if (row == null || colDef == null) return "-";
        
        // Use the original index directly - this ensures we get the correct column
        if (colDef.OriginalIndex >= 0 && colDef.OriginalIndex < row.Count)
        {
            return row[colDef.OriginalIndex]?.ToString() ?? "-";
        }
        
        // Fallback: try to find by name if index is invalid
        return "-";
    }
}

