            ("Query Hash", "A unique hash identifier for the query execution"),
            ("Execution Time", "How long the query took to execute in milliseconds"),
            ("Query Statistics", "Detailed query execution statistics including resource usage and dataset information (JSON format)"),
            ("Query ID", "Unique identifier for the query execution"),
            ("Source", "The source system or component that generated this log entry")
        };
        
        for (int i = 0; i < table.Columns.Count; i++)
        {
            var colName = table.Columns[i].Name ?? "";
            if (i < staticMappings.Count)
            {
                columns.Add(new StaticColumnDefinition 
                { 
                    OriginalName = colName,
                    OriginalIndex = i,
                    DisplayName = staticMappings[i].DisplayName, 
                    Description = staticMappings[i].Description 
