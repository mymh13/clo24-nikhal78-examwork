    private StaticTableDefinition GetDefaultDefinition(QueryTable table)
    {
        // Static descriptions for Application Insights query results
        // Based on typical KQL query structure: customEvents | summarize Count = count() by name
        var columns = new List<StaticColumnDefinition>();
        
        // Static column mappings for typical Application Insights query results
        var defaultColumnMappings = new List<(string DisplayName, string Description)>
        {
            ("Event Name", "The name of the custom event from Application Insights (e.g., BookingCreated, OutboxEventProcessed)"),
            ("Event Count", "The number of times this event occurred in the specified time range"),
            ("Timestamp", "The date and time when the event occurred"),
            ("Event Data", "Additional event data or metadata"),
            ("Query Result", "Application Insights query execution result"),
            ("Column 6", "Additional query result column"),
            ("Column 7", "Additional query result column"),
            ("Column 8", "Additional query result column"),
            ("Column 9", "Additional query result column"),
            ("Column 10", "Additional query result column")
        };
        
        for (int i = 0; i < table.Columns.Count; i++)
        {
            var colName = table.Columns[i].Name ?? "";
            
            // Try to match by column name first
            string displayName;
            string description;
            
            if (colName.Equals("name", StringComparison.OrdinalIgnoreCase))
            {
                displayName = "Event Name";
                description = "The name of the custom event from Application Insights (e.g., BookingCreated, OutboxEventProcessed, ServiceBusEventPublished, ModeSwitch)";
            }
            else if (colName == "Count")
            {
                displayName = "Event Count";
                description = "The number of times this event occurred in the specified time range";
            }
            else if (colName.Contains("timestamp", StringComparison.OrdinalIgnoreCase))
            {
                displayName = "Timestamp";
                description = "The date and time when the event occurred (UTC)";
            }
            else if (i < defaultColumnMappings.Count)
            {
                displayName = defaultColumnMappings[i].DisplayName;
                description = defaultColumnMappings[i].Description;
            }
            else
            {
                displayName = $"Column {i + 1}";
                description = "Application Insights query result data";
            }
            
            columns.Add(new StaticColumnDefinition
            {
                OriginalName = colName,
                OriginalIndex = i,
                DisplayName = displayName,
                Description = description
            });
        }

        return new StaticTableDefinition
        {
            Description = "Application Insights Query Results - Custom events and query execution data from the event-driven ticketing system",
            Columns = columns
        };
    }

    private string GetCellValue(List<object?> row, StaticColumnDefinition colDef)
    {
        if (row == null || colDef == null) return "-";
        
        // Use the original index directly - this ensures we get the correct column
        if (colDef.OriginalIndex >= 0 && colDef.OriginalIndex < row.Count)
        {
            return row[colDef.OriginalIndex]?.ToString() ?? "-";
        }
        
        // Fallback: try to find by name if index is invalid
        return "-";
    }
