@page "/demo"
@using System.Security.Claims
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using Ticketing.Contracts.Bookings
@using Ticketing.Web.Components
@attribute [Authorize(Roles = "Admin")]
@inject IHttpContextAccessor HttpContextAccessor
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Event-Driven Architecture Demo</PageTitle>

<div class="container demo-page-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-lg);">
        <h1 style="margin: 0;">Event-Driven Architecture Demo</h1>
        @{
            var user = HttpContextAccessor.HttpContext?.User;
            var landingPageUrl = Ticketing.Web.Helpers.NavigationHelper.GetLandingPageUrl(user);
        }
        <a href="@landingPageUrl" class="btn btn-secondary" style="margin-left: auto;">Back to Dashboard</a>
    </div>
    
    @{
        // user is already defined above
    }
    
    @if (user?.Identity?.IsAuthenticated == true)
    {
        <!-- Top Section: Event-Driven Architecture Status (Full Width) -->
        <div class="demo-section" style="margin-bottom: var(--spacing-xl);">
            <h2>Event-Driven Architecture Status</h2>
            <div class="mini-health-check" style="padding: var(--spacing-md); background: var(--bg-secondary); border-radius: 4px;">
                @if (miniHealth != null)
                {
                    <div style="margin-bottom: var(--spacing-sm);">
                        <strong>App Configuration:</strong> 
                        @if (miniHealth.AppConfigurationConfigured)
                        {
                            <span style="color: #4caf50;"> ✓ Configured (@miniHealth.AppConfigurationName)</span>
                            <span style="color: #666; margin-left: 8px;">- Sentinel: @miniHealth.SentinelValue</span>
                        }
                        else
                        {
                            <span style="color: #f44336;"> ✗ Not configured</span>
                        }
                    </div>
                    <div style="margin-bottom: var(--spacing-sm);">
                        <strong>Feature Manager:</strong> 
                        @if (miniHealth.FeatureManagerAvailable)
                        {
                            <span style="color: #4caf50;"> ✓ Available</span>
                            <span style="color: #666; margin-left: 8px;">- @miniHealth.FeatureFlagDisplay</span>
                        }
                        else
                        {
                            <span style="color: #f44336;"> ✗ Not available</span>
                        }
                    </div>
                    <div style="margin-bottom: var(--spacing-sm);">
                        <strong>Outbox Service:</strong> 
                        @if (miniHealth.OutboxServiceStatus == "Operational")
                        {
                            <span style="color: #4caf50;"> ✓ Registered - Operational</span>
                            <span style="color: #666; margin-left: 8px;">(@miniHealth.OutboxPendingEventsCount pending events)</span>
                        }
                        else
                        {
                            <span style="color: #f44336;"> ✗ @miniHealth.OutboxServiceStatus</span>
                        }
                    </div>
                    <div style="margin-top: var(--spacing-md);">
                        <button class="btn btn-primary" @onclick="ToggleFeatureFlag" disabled="@(isToggling || isCooldown || isWaitingForPropagation)" style="width: 100%;">
                            @if (isToggling)
                            {
                                <text>Toggling...</text>
                            }
                            else if (isCooldown)
                            {
                                <text>Please wait... (@cooldownRemainingSeconds)s</text>
                            }
                            else if (isWaitingForPropagation)
                            {
                                <text>Waiting for propagation...</text>
                            }
                            else
                            {
                                <text>Toggle Feature Flag (@(miniHealth.FeatureFlagValue == true ? "Disable" : "Enable") Event-Driven Mode)</text>
                            }
                        </button>
                        @if (!string.IsNullOrEmpty(toggleMessage))
                        {
                            <p class="toggle-message" style="margin-top: var(--spacing-sm); color: @(toggleMessage.Contains("Error") ? "#f44336" : "#4caf50");">@toggleMessage</p>
                        }
                        @if (isWaitingForPropagation)
                        {
                            <div style="margin-top: var(--spacing-sm); padding: var(--spacing-sm); background-color: #fff3cd; border: 1px solid #ffeeba; color: #856404; border-radius: 4px;">
                                <div class="spinner-border spinner-border-sm text-warning" role="status" style="margin-right: 8px;">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                @propagationStatus
                            </div>
                        }
                        else if (propagationComplete)
                        {
                            <div style="margin-top: var(--spacing-sm); padding: var(--spacing-sm); background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; border-radius: 4px;">
                                <span class="oi oi-check" aria-hidden="true" style="margin-right: 8px;"></span>
                                @propagationStatus
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Loading health status...</p>
                }
            </div>
        </div>

        <hr class="section-divider" />

        <!-- Application Insights Query Results (Full Width) -->
        <div class="demo-section" style="margin-bottom: var(--spacing-xl);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-md);">
                    <h2 style="margin: 0;">Application Insights - Custom Events</h2>
                    <div style="display: flex; gap: var(--spacing-md); align-items: center;">
                        <button class="btn btn-primary" @onclick="RefreshInsights" disabled="@isLoadingInsights">
                            @if (isLoadingInsights)
                            {
                                <text>Loading...</text>
                            }
                            else
                            {
                                <text>Refresh Events</text>
                            }
                        </button>
                        <label style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" @bind="autoRefreshInsights" />
                            <span>Auto-refresh (every 10s)</span>
                        </label>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(insightsError))
                {
                    <div class="error-message" style="margin-bottom: var(--spacing-md);">
                        <p>@insightsError</p>
                    </div>
                }
                
                @if (insightsData != null && insightsData.Success && insightsData.Tables != null && insightsData.Tables.Any())
                {
                    // Filter tables - exclude all metadata tables completely
                    // Also exclude any table that contains Visualization JSON in its cells
                    var dataTables = insightsData.Tables.Where(t => 
                        t != null && 
                        t.Name != "Visualization" && 
                        t.Name != "QueryProperties" && 
                        t.Name != "QueryStatus" && 
                        !t.Name.StartsWith("@") && 
                        t.Rows != null && 
                        t.Rows.Any() && 
                        t.Rows.Count > 0 &&
                        // Exclude tables where rows contain Visualization JSON metadata
                        !t.Rows.Any(row => row != null && row.Any(cell => 
                            cell != null && 
                            cell.ToString()?.Contains("\"Visualization\"") == true &&
                            cell.ToString()?.Contains("\"Title\"") == true &&
                            cell.ToString()?.Contains("\"XColumn\"") == true))).ToList();
                    
                    @foreach (var table in dataTables)
                    {
                        <div style="margin-bottom: var(--spacing-lg);">
                            @{
                                // Get static table definition for this table
                                var tableDefinition = GetStaticTableDefinition(table);
                                // Remove "Application Insights -" prefix from title
                                var tableTitle = GetStaticTableTitle(table);
                                if (tableTitle.StartsWith("Application Insights -"))
                                {
                                    tableTitle = tableTitle.Substring("Application Insights -".Length).Trim();
                                }
                            }
                            <div style="margin-bottom: var(--spacing-md);">
                                <h3 style="margin: 0;">@tableTitle</h3>
                            </div>
                            <div class="bookings-table-container">
                                <table class="bookings-table insights-fixed-table">
                                    <colgroup>
                                        @foreach (var colDef in tableDefinition.Columns)
                                        {
                                            <col style="width: 150px; max-width: 150px;" />
                                        }
                                        <col style="width: 140px; min-width: 140px;" />
                                    </colgroup>
                                    <tbody>
                                        <tr style="background-color: var(--color-bg-secondary); border-bottom: 1px solid var(--color-border);">
                                            @foreach (var colDef in tableDefinition.Columns)
                                            {
                                                <td class="insights-cell-truncate" style="padding: 8px; font-size: 0.85em; color: var(--color-text-secondary); font-style: italic; text-align: left; width: 150px; max-width: 150px;">
                                                    <strong>@colDef.DisplayName:</strong> @colDef.Description
                                                </td>
                                            }
                                            <td style="padding: 8px; font-size: 0.85em; color: var(--color-text-secondary); font-style: italic; width: 140px; min-width: 140px;">
                                                View full data or copy row/table
                                            </td>
                                        </tr>
                                        @{
                                            var rowIndex = 0;
                                        }
                                        @foreach (var row in table.Rows)
                                        {
                                            var currentRowIndex = rowIndex;
                                            <tr>
                                                @foreach (var colDef in tableDefinition.Columns)
                                                {
                                                    var cellValue = GetCellValue(row, colDef);
                                                    var shouldTruncate = cellValue.Length > 15;
                                                    <td class="insights-cell-truncate" title="@colDef.Description">
                                                        <span class="text-truncate-cell" title="@(shouldTruncate ? cellValue : "")">@cellValue</span>
                                                    </td>
                                                }
                                                <td>
                                                    <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                                        <button class="cell-action-btn" @onclick="() => ViewRowDetails(table, currentRowIndex)" title="View full row data">
                                                            👁️ View
                                                        </button>
                                                        <button class="cell-action-btn" @onclick="() => CopyRowData(table, currentRowIndex)" title="Copy row data">
                                                            📋 Copy
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            rowIndex++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div style="margin-top: var(--spacing-sm); text-align: right;">
                                <button class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.85em;" @onclick="() => CopyTableData(table)">
                                    📋 Copy Table Data
                                </button>
                            </div>
                        </div>
                    }
                }
                else if (insightsData != null && !insightsData.Success)
                {
                    <div class="error-message">
                        <p>Error: @insightsData.Error</p>
                    </div>
                }
                else if (!isLoadingInsights)
                {
                    <p style="color: var(--color-text-muted);">No data available. Click "Refresh Events" to load.</p>
                }
        </div>

        <hr class="section-divider" />

        <!-- Bottom Section: Booking Management (Full Width) -->
        <BookingManagement OnBookingCreated="OnBookingCreatedHandler" />
    }
    else
    {
        <p>Not authenticated. <a href="/login">Go to login page</a> to authenticate.</p>
    }
</div>

<!-- Modal for viewing row details -->
@if (showModal && selectedRowData != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Row Details - @selectedTableName</h3>
                <button class="modal-close-btn" @onclick="CloseModal" title="Close">×</button>
            </div>
            <div class="modal-body">
                <div style="margin-bottom: var(--spacing-md);">
                    <button class="btn btn-secondary" @onclick="CopyModalData" style="margin-bottom: var(--spacing-md);">
                        📋 Copy All Data
                    </button>
                </div>
                <div style="margin-bottom: var(--spacing-lg);">
                    <h4 style="color: var(--color-primary); margin-bottom: var(--spacing-sm);">Table View</h4>
                    <table class="modal-table">
                        <thead>
                            <tr>
                                <th>Column</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (selectedTable != null && selectedRowIndex >= 0 && selectedRowIndex < selectedTable.Rows.Count)
                            {
                                var row = selectedTable.Rows[selectedRowIndex];
                                @for (int i = 0; i < selectedTable.Columns.Count && i < row.Count; i++)
                                {
                                    <tr>
                                        <td><strong>@selectedTable.Columns[i].Name</strong></td>
                                        <td>@(row[i]?.ToString() ?? "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <h4 style="color: var(--color-primary); margin-bottom: var(--spacing-sm);">JSON Format</h4>
                    <div class="json-display">@selectedRowJson</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    // Application Insights state
    private QueryResult? insightsData;
    private bool isLoadingInsights = false;
    private string insightsError = string.Empty;
    private bool autoRefreshInsights = false;
    private CancellationTokenSource? autoRefreshCancellationTokenSource;

    // Feature flag state (from AdminLandingPage)
    private MiniHealthStatus? miniHealth;
    private bool isToggling = false;
    private bool isCooldown = false;
    private int cooldownRemainingSeconds = 0;
    private string toggleMessage = string.Empty;
    private DateTime lastToggleTime = DateTime.MinValue;
    private const int MinToggleIntervalSeconds = 2;
    private const int CooldownSeconds = 5;
    private bool isWaitingForPropagation = false;
    private bool propagationComplete = false;
    private string propagationStatus = string.Empty;
    private bool? expectedFeatureFlagValue = null;
    private CancellationTokenSource? propagationCancellationTokenSource;
    private const int PollingIntervalSeconds = 3;
    private const int MaxPropagationWaitSeconds = 60;

    // Booking management callback
    private async Task OnBookingCreatedHandler()
    {
        // Refresh insights after booking creation (wait a bit for ingestion)
        await Task.Delay(2000);
        await RefreshInsights();
        await LoadMiniHealth();
    }

    // Modal state
    private bool showModal = false;
    private QueryTable? selectedTable = null;
    private int selectedRowIndex = -1;
    private string selectedTableName = string.Empty;
    private string selectedRowJson = string.Empty;
    private Dictionary<string, object?>? selectedRowData = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadMiniHealth();
        await RefreshInsights();
        StartAutoRefresh();
    }

    private async Task LoadMiniHealth()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("BlazorServer");
            miniHealth = await httpClient.GetFromJsonAsync<MiniHealthStatus>("/api/featureflag/mini-health");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading mini health: {ex.Message}");
        }
    }

    private async Task RefreshInsights()
    {
        isLoadingInsights = true;
        insightsError = string.Empty;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("BlazorServer");
            var queryRequest = new
            {
                Query = @"
customEvents
| where timestamp > ago(1h)
| summarize Count = count() by name
| order by Count desc",
                Timespan = "PT1H"
            };

            var response = await httpClient.PostAsJsonAsync("/api/applicationinsights/query", queryRequest);
            
            if (response.IsSuccessStatusCode)
            {
                insightsData = await response.Content.ReadFromJsonAsync<QueryResult>();
                if (insightsData?.Success == true)
                {
                    insightsError = string.Empty;
                }
                else
                {
                    insightsError = insightsData?.Error ?? "Unknown error";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                insightsError = $"HTTP {response.StatusCode}: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            insightsError = $"Error: {ex.Message}";
            Console.WriteLine($"Error refreshing insights: {ex.Message}");
        }
        finally
        {
            isLoadingInsights = false;
            StateHasChanged();
        }
    }

    private void StartAutoRefresh()
    {
        autoRefreshCancellationTokenSource?.Cancel();
        autoRefreshCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = autoRefreshCancellationTokenSource.Token;

        _ = Task.Run(async () =>
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(10000, cancellationToken); // 10 seconds
                if (autoRefreshInsights && !cancellationToken.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshInsights();
                        await LoadMiniHealth(); // Also refresh health status
                    });
                }
            }
        }, cancellationToken);
    }


    private async Task ToggleFeatureFlag()
    {
        var timeSinceLastToggle = (DateTime.UtcNow - lastToggleTime).TotalSeconds;
        if (timeSinceLastToggle < MinToggleIntervalSeconds)
        {
            toggleMessage = $"Please wait {MinToggleIntervalSeconds - (int)timeSinceLastToggle} more second(s) before toggling again.";
            StateHasChanged();
            await Task.Delay(1000);
            toggleMessage = string.Empty;
            StateHasChanged();
            return;
        }

        isToggling = true;
        toggleMessage = string.Empty;
        lastToggleTime = DateTime.UtcNow;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("BlazorServer");
            var response = await httpClient.PostAsync("/api/featureflag/toggle", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ToggleResult>();
                if (result?.Success == true)
                {
                    toggleMessage = result.Message;
                    expectedFeatureFlagValue = result.NewValue;
                    
                    isCooldown = true;
                    for (int i = CooldownSeconds; i > 0; i--)
                    {
                        cooldownRemainingSeconds = i;
                        StateHasChanged();
                        await Task.Delay(1000);
                    }
                    isCooldown = false;
                    
                    _ = StartPropagationPolling();
                }
                else
                {
                    toggleMessage = result?.Message ?? "Toggle failed";
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toggleMessage = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            toggleMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isToggling = false;
            StateHasChanged();
        }
    }

    private async Task StartPropagationPolling()
    {
        if (expectedFeatureFlagValue == null) return;

        propagationCancellationTokenSource?.Cancel();
        propagationCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = propagationCancellationTokenSource.Token;

        isWaitingForPropagation = true;
        propagationComplete = false;
        propagationStatus = "Checking for change...";
        StateHasChanged();

        var startTime = DateTime.UtcNow;
        var pollCount = 0;

        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(PollingIntervalSeconds), cancellationToken);
                pollCount++;

                var elapsed = (DateTime.UtcNow - startTime).TotalSeconds;
                if (elapsed > MaxPropagationWaitSeconds)
                {
                    propagationStatus = $"Timeout after {MaxPropagationWaitSeconds} seconds.";
                    isWaitingForPropagation = false;
                    StateHasChanged();
                    return;
                }

                await LoadMiniHealth();
                StateHasChanged();

                if (miniHealth?.FeatureFlagValue == expectedFeatureFlagValue)
                {
                    propagationComplete = true;
                    isWaitingForPropagation = false;
                    propagationStatus = $"Change detected after {elapsed:F1} seconds ({pollCount} checks)";
                    StateHasChanged();

                    await Task.Delay(5000, cancellationToken);
                    propagationComplete = false;
                    expectedFeatureFlagValue = null;
                    toggleMessage = string.Empty;
                    StateHasChanged();
                    return;
                }
                else
                {
                    propagationStatus = $"Waiting... ({elapsed:F0}s elapsed, {pollCount} checks)";
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException)
        {
            isWaitingForPropagation = false;
            propagationComplete = false;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        autoRefreshCancellationTokenSource?.Cancel();
        autoRefreshCancellationTokenSource?.Dispose();
        propagationCancellationTokenSource?.Cancel();
        propagationCancellationTokenSource?.Dispose();
        return ValueTask.CompletedTask;
    }

    private void ViewRowDetails(QueryTable table, int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= table.Rows.Count) return;

        selectedTable = table;
        selectedRowIndex = rowIndex;
        selectedTableName = table.Name;
        
        var row = table.Rows[rowIndex];
        selectedRowData = new Dictionary<string, object?>();
        var jsonDict = new Dictionary<string, object?>();

        for (int i = 0; i < table.Columns.Count && i < row.Count; i++)
        {
            var columnName = table.Columns[i].Name;
            var value = row[i];
            selectedRowData[columnName] = value;
            jsonDict[columnName] = value;
        }

        selectedRowJson = System.Text.Json.JsonSerializer.Serialize(jsonDict, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        selectedTable = null;
        selectedRowIndex = -1;
        selectedTableName = string.Empty;
        selectedRowJson = string.Empty;
        selectedRowData = null;
        StateHasChanged();
    }

    private async Task CopyRowData(QueryTable table, int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= table.Rows.Count) return;

        var row = table.Rows[rowIndex];
        var data = new Dictionary<string, object?>();

        for (int i = 0; i < table.Columns.Count && i < row.Count; i++)
        {
            data[table.Columns[i].Name] = row[i];
        }

        var json = System.Text.Json.JsonSerializer.Serialize(data, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            await JSRuntime.InvokeVoidAsync("alert", "Row data copied to clipboard!");
        }
        catch
        {
            // Fallback if clipboard API fails
            await JSRuntime.InvokeVoidAsync("alert", "Failed to copy to clipboard. Please use the View button to see the data.");
        }
    }

    private async Task CopyTableData(QueryTable table)
    {
        var tableData = new
        {
            TableName = table.Name,
            Columns = table.Columns.Select(c => new { c.Name, c.Type }).ToList(),
            Rows = table.Rows.Select(row =>
            {
                var rowDict = new Dictionary<string, object?>();
                for (int i = 0; i < table.Columns.Count && i < row.Count; i++)
                {
                    rowDict[table.Columns[i].Name] = row[i];
                }
                return rowDict;
            }).ToList()
        };

        var json = System.Text.Json.JsonSerializer.Serialize(tableData, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            await JSRuntime.InvokeVoidAsync("alert", "Table data copied to clipboard!");
        }
        catch
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to copy to clipboard.");
        }
    }

    private async Task CopyModalData()
    {
        if (string.IsNullOrEmpty(selectedRowJson)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", selectedRowJson);
            await JSRuntime.InvokeVoidAsync("alert", "Data copied to clipboard!");
        }
        catch
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to copy to clipboard.");
        }
    }

    private class MiniHealthStatus
    {
        public string AppConfigurationName { get; set; } = string.Empty;
        public bool AppConfigurationConfigured { get; set; }
        public string SentinelValue { get; set; } = string.Empty;
        public bool FeatureManagerAvailable { get; set; }
        public bool? FeatureFlagValue { get; set; }
        public string FeatureFlagDisplay { get; set; } = "Not tested";
        public string OutboxServiceStatus { get; set; } = "Not tested";
        public int OutboxPendingEventsCount { get; set; }
    }

    private class ToggleResult
    {
        public bool Success { get; set; }
        public bool? PreviousValue { get; set; }
        public bool? NewValue { get; set; }
        public string? SentinelValue { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private class QueryResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public List<QueryTable>? Tables { get; set; }
    }

    private class QueryTable
    {
        public string Name { get; set; } = string.Empty;
        public List<QueryColumn> Columns { get; set; } = new();
        public List<List<object?>> Rows { get; set; } = new();
    }

    private class QueryColumn
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
    }

    private string GetStaticTableTitle(QueryTable table)
    {
        if (table == null || table.Columns == null) return "Unknown Table";

        var columnNames = table.Columns.Select(c => c.Name ?? "").ToList();

        // Static title determination - matches GetStaticTableDefinition logic
        if (columnNames.Contains("name") && columnNames.Contains("Count"))
        {
            return "Custom Events Summary";
        }
        else if (columnNames.Any(c => c.Contains("timestamp", StringComparison.OrdinalIgnoreCase)) || 
                 (table.Columns.Count >= 8 && table.Columns.Any(c => int.TryParse(c.Name ?? "", out _))))
        {
            return "Event Logs";
        }
        else if (table.Name.Contains("QueryResult", StringComparison.OrdinalIgnoreCase) || 
                 table.Name.Contains("QueryProperties", StringComparison.OrdinalIgnoreCase) || 
                 table.Name.Contains("QueryStatus", StringComparison.OrdinalIgnoreCase) ||
                 (table.Columns.Count >= 4 && table.Columns.Any(c => int.TryParse(c.Name ?? "", out _))))
        {
            return "Outbox Metadata";
        }

        return "Query Results";
    }

    private class StaticTableDefinition
    {
        public string Description { get; set; } = string.Empty;
        public List<StaticColumnDefinition> Columns { get; set; } = new();
    }

    private class StaticColumnDefinition
    {
        public string OriginalName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int OriginalIndex { get; set; } = -1; // Index in the original table
    }

    private StaticTableDefinition GetStaticTableDefinition(QueryTable table)
    {
        if (table == null || table.Columns == null || table.Columns.Count == 0) 
        {
            return new StaticTableDefinition { Description = "Unknown Table", Columns = new List<StaticColumnDefinition>() };
        }

        // Static mappings based on table structure - no dynamic detection
        // Table 1: Custom Events Summary (has "name" and "Count" columns)
        var columnNames = table.Columns.Select(c => c.Name ?? "").ToList();
        if (columnNames.Contains("name") && columnNames.Contains("Count"))
        {
            return GetCustomEventsSummaryDefinition(table);
        }

        // Table 2: Event Logs (has timestamp column or 8+ numeric columns)
        if (columnNames.Any(c => c.Contains("timestamp", StringComparison.OrdinalIgnoreCase)) || 
            (table.Columns.Count >= 8 && table.Columns.Any(c => int.TryParse(c.Name ?? "", out _))))
        {
            return GetEventLogsDefinition(table);
        }

        // Table 3: Outbox Metadata (has QueryResult/QueryProperties/QueryStatus in name or 4+ numeric columns)
        if (table.Name.Contains("QueryResult", StringComparison.OrdinalIgnoreCase) || 
            table.Name.Contains("QueryProperties", StringComparison.OrdinalIgnoreCase) || 
            table.Name.Contains("QueryStatus", StringComparison.OrdinalIgnoreCase) ||
            (table.Columns.Count >= 4 && table.Columns.Any(c => int.TryParse(c.Name ?? "", out _))))
        {
            return GetOutboxMetadataDefinition(table);
        }

        // Default: Unknown table structure
        return GetDefaultDefinition(table);
    }

    private StaticTableDefinition GetCustomEventsSummaryDefinition(QueryTable table)
    {
        var columns = new List<StaticColumnDefinition>();
        for (int i = 0; i < table.Columns.Count; i++)
        {
            var colName = table.Columns[i].Name ?? "";
            if (colName.Equals("name", StringComparison.OrdinalIgnoreCase))
            {
                columns.Add(new StaticColumnDefinition 
                { 
                    OriginalName = colName,
                    OriginalIndex = i,
                    DisplayName = "Event Name", 
                    Description = "The name of the custom event tracked in Application Insights (e.g., BookingCreated, OutboxEventProcessed, ServiceBusEventPublished, ModeSwitch)" 
                });
            }
            else if (colName == "Count")
            {
                columns.Add(new StaticColumnDefinition 
                { 
                    OriginalName = colName,
                    OriginalIndex = i,
                    DisplayName = "Event Count", 
                    Description = "The total number of times this event occurred in the last hour, showing activity in the event-driven architecture" 
                });
            }
            else
            {
                columns.Add(new StaticColumnDefinition 
                { 
                    OriginalName = colName,
                    OriginalIndex = i,
                    DisplayName = $"Column {i + 1}", 
                    Description = "Additional column data" 
                });
            }
        }
        
        return new StaticTableDefinition
        {
            Description = "Summary of all custom events tracked in Application Insights for the event-driven ticketing system. Shows event counts for bookings, outbox processing, Service Bus publishing, and mode switches.",
            Columns = columns
        };
    }

