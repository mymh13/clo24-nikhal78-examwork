@page "/admin"
@using System.Security.Claims
@using System.Net.Http.Json
@using Ticketing.Contracts.Bookings
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Admin Dashboard</PageTitle>

<div class="container">
    <h1>Admin Dashboard</h1>
    
    @{
        var user = HttpContextAccessor.HttpContext?.User;
    }
    
    @if (user?.Identity?.IsAuthenticated == true)
    {
        <div class="user-info">
            <p><strong>Authenticated as:</strong> @user.Identity.Name</p>
            <p><strong>User ID:</strong> @user.FindFirst(ClaimTypes.NameIdentifier)?.Value</p>
            <p><strong>Email:</strong> @user.FindFirst(ClaimTypes.Email)?.Value</p>
            <p><strong>Role:</strong> @user.FindFirst(ClaimTypes.Role)?.Value</p>
            <form method="post" action="/api/auth/logout" style="margin-top: 20px;">
                <button type="submit" class="btn btn-secondary">Logout</button>
            </form>
        </div>

        <hr class="section-divider" />

        <div class="booking-section">
            <h2>Booking Management</h2>
            
            <div class="booking-form-container">
                <h3>Create Booking</h3>
                <form @onsubmit="CreateBooking" @onsubmit:preventDefault="true" class="booking-form">
                    <div class="form-group">
                        <label for="customerId">Customer ID:</label>
                        <input id="customerId" type="text" @bind="newBooking.CustomerId" class="form-input" placeholder="Enter customer ID" />
                    </div>
                    <div class="form-group">
                        <label for="customerName">Customer Name:</label>
                        <input id="customerName" type="text" @bind="newBooking.CustomerName" class="form-input" placeholder="Enter customer name" />
                    </div>
                    <button type="submit" class="btn btn-primary">Create Booking</button>
                </form>
                @if (!string.IsNullOrEmpty(createResult))
                {
                    <div class="result-box">
                        <pre>@createResult</pre>
                    </div>
                }
            </div>

            <hr class="section-divider" />

            <div class="booking-form-container">
                <h3>Get Bookings by Customer</h3>
                <form @onsubmit="GetBookings" @onsubmit:preventDefault="true" class="booking-form">
                    <div class="form-group">
                        <label for="searchCustomerId">Customer ID:</label>
                        <input id="searchCustomerId" type="text" @bind="searchCustomerId" class="form-input" placeholder="Enter customer ID to search" />
                    </div>
                    <button type="submit" class="btn btn-primary">Get Bookings</button>
                </form>
                @if (!string.IsNullOrEmpty(getResult))
                {
                    <div class="result-box">
                        <pre>@getResult</pre>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <p>Not authenticated. <a href="/login">Go to login page</a> to authenticate.</p>
    }
</div>

@code {
    private Booking newBooking = new();
    private string searchCustomerId = string.Empty;
    private string createResult = string.Empty;
    private string getResult = string.Empty;

    private async Task CreateBooking()
    {
        createResult = "Creating...";
        try
        {
            var response = await Http.PostAsJsonAsync("/api/bookings", newBooking);
            var content = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                createResult = $"Success ({response.StatusCode}):\n{content}";
                newBooking = new Booking(); // Reset form
            }
            else
            {
                createResult = $"Error ({response.StatusCode}):\n{content}";
            }
        }
        catch (Exception ex)
        {
            createResult = $"Exception: {ex.Message}";
        }
    }

    private async Task GetBookings()
    {
        getResult = "Loading...";
        try
        {
            var response = await Http.GetAsync($"/api/bookings/customer/{searchCustomerId}");
            var content = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                getResult = $"Success ({response.StatusCode}):\n{content}";
            }
            else
            {
                getResult = $"Error ({response.StatusCode}):\n{content}";
            }
        }
        catch (Exception ex)
        {
            getResult = $"Exception: {ex.Message}";
        }
    }
}

