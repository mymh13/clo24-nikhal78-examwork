@page "/admin"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject IHttpContextAccessor HttpContextAccessor
@inject IHttpClientFactory HttpClientFactory
@implements IAsyncDisposable

<PageTitle>Admin Dashboard</PageTitle>

<div class="container">
    <h1>Admin Dashboard</h1>
    
    @{
        var user = HttpContextAccessor.HttpContext?.User;
    }
    
    @if (user?.Identity?.IsAuthenticated == true)
    {
        <div class="user-info">
            <div class="user-info-text">
                <p><strong>Authenticated as:</strong> @user.Identity.Name</p>
                <p><strong>Role:</strong> @user.FindFirst(ClaimTypes.Role)?.Value</p>
            </div>
            <form method="post" action="/api/auth/logout" class="user-info-logout">
                <button type="submit" class="btn btn-secondary">Logout</button>
            </form>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>Event-Driven Architecture Status:</strong></p>
                <div class="mini-health-check" style="margin-top: var(--spacing-md); padding: var(--spacing-md); background: var(--bg-secondary); border-radius: 4px;">
                    @if (miniHealth != null)
                    {
                        <div style="margin-bottom: var(--spacing-sm);">
                            <strong>App Configuration:</strong> 
                            @if (miniHealth.AppConfigurationConfigured)
                            {
                                <span style="color: #4caf50;"> ✓ Configured (@miniHealth.AppConfigurationName)</span>
                                <span style="color: #666; margin-left: 8px;">- Sentinel: @miniHealth.SentinelValue</span>
                            }
                            else
                            {
                                <span style="color: #f44336;"> ✗ Not configured</span>
                            }
                        </div>
                        <div style="margin-bottom: var(--spacing-sm);">
                            <strong>Feature Manager:</strong> 
                            @if (miniHealth.FeatureManagerAvailable)
                            {
                                <span style="color: #4caf50;"> ✓ Available</span>
                                <span style="color: #666; margin-left: 8px;">- @miniHealth.FeatureFlagDisplay</span>
                            }
                            else
                            {
                                <span style="color: #f44336;"> ✗ Not available</span>
                            }
                        </div>
                        <div style="margin-bottom: var(--spacing-sm);">
                            <strong>Outbox Service:</strong> 
                            @if (miniHealth.OutboxServiceStatus == "Operational")
                            {
                                <span style="color: #4caf50;"> ✓ Registered - Operational</span>
                                <span style="color: #666; margin-left: 8px;">(@miniHealth.OutboxPendingEventsCount pending events)</span>
                            }
                            else
                            {
                                <span style="color: #f44336;"> ✗ @miniHealth.OutboxServiceStatus</span>
                            }
                        </div>
                        <div style="margin-top: var(--spacing-md);">
                            <button class="btn btn-primary" @onclick="ToggleFeatureFlag" disabled="@(isToggling || isCooldown)">
                                @if (isToggling)
                                {
                                    <text>Toggling...</text>
                                }
                                else if (isCooldown)
                                {
                                    <text>Please wait... (@cooldownRemainingSeconds)s</text>
                                }
                                else
                                {
                                    <text>Toggle Feature Flag (@(miniHealth.FeatureFlagValue == true ? "Disable" : "Enable") Event-Driven Mode)</text>
                                }
                            </button>
                            @if (!string.IsNullOrEmpty(toggleMessage))
                            {
                                <div style="margin-top: var(--spacing-sm); color: @(toggleMessage.Contains("Error") ? "#f44336" : "#4caf50");">
                                    @toggleMessage
                                </div>
                            }
                            @if (isWaitingForPropagation)
                            {
                                <div style="margin-top: var(--spacing-sm); padding: var(--spacing-sm); background: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="animation: spin 1s linear infinite;">⏳</span>
                                        <span><strong>Waiting for change to take effect...</strong></span>
                                    </div>
                                    <div style="margin-top: 4px; font-size: 0.9em; color: #666;">
                                        @propagationStatus
                                    </div>
                                </div>
                            }
                            @if (propagationComplete)
                            {
                                <div style="margin-top: var(--spacing-sm); padding: var(--spacing-sm); background: #d4edda; border-left: 4px solid #28a745; border-radius: 4px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="color: #28a745; font-size: 1.2em;">✓</span>
                                        <span><strong>Change applied successfully!</strong></span>
                                    </div>
                                    <div style="margin-top: 4px; font-size: 0.9em; color: #666;">
                                        Feature flag is now @(miniHealth?.FeatureFlagValue == true ? "enabled" : "disabled")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Loading health status...</p>
                    }
                </div>
            </div>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>Event-Driven Architecture Demo:</strong> Complete demo page with Application Insights, feature flag toggle, and booking management all in one view.</p>
                <div class="button-container" style="margin-top: var(--spacing-md);">
                    <a href="/demo" class="btn btn-primary" style="background-color: #2196F3; font-weight: bold;">Go to Demo Page</a>
                </div>
            </div>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>User Management:</strong> Create, view, edit, and delete user accounts.</p>
                <div class="button-container" style="margin-top: var(--spacing-md);">
                    <a href="/users" class="btn btn-primary">Go to User Management</a>
                </div>
            </div>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>Ticket Management:</strong> Create, view, edit, and delete tickets for all users.</p>
                <div class="button-container" style="margin-top: var(--spacing-md);">
                    <a href="/bookings" class="btn btn-primary">Go to Booking Management</a>
                </div>
            </div>
        </div>


    }
    else
    {
        <p>Not authenticated. <a href="/login">Go to login page</a> to authenticate.</p>
    }
</div>

@code {
    private MiniHealthStatus? miniHealth;
    private bool isToggling = false;
    private bool isCooldown = false;
    private int cooldownRemainingSeconds = 0;
    private string toggleMessage = string.Empty;
    private DateTime lastToggleTime = DateTime.MinValue;
    private const int MinToggleIntervalSeconds = 2;
    private const int CooldownSeconds = 5;
    
    // Propagation tracking
    private bool isWaitingForPropagation = false;
    private bool propagationComplete = false;
    private string propagationStatus = string.Empty;
    private bool? expectedFeatureFlagValue = null;
    private CancellationTokenSource? propagationCancellationTokenSource = null;
    private const int PollingIntervalSeconds = 3;
    private const int MaxPropagationWaitSeconds = 60;

    protected override async Task OnInitializedAsync()
    {
        await LoadMiniHealth();
    }

    private async Task LoadMiniHealth()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("BlazorServer");
            miniHealth = await httpClient.GetFromJsonAsync<MiniHealthStatus>("/api/featureflag/mini-health");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading mini health: {ex.Message}");
        }
    }

    private async Task ToggleFeatureFlag()
    {
        // Debounce: Prevent rapid successive clicks
        var timeSinceLastToggle = (DateTime.UtcNow - lastToggleTime).TotalSeconds;
        if (timeSinceLastToggle < MinToggleIntervalSeconds)
        {
            toggleMessage = $"Please wait {MinToggleIntervalSeconds - (int)timeSinceLastToggle} more second(s) before toggling again.";
            StateHasChanged();
            await Task.Delay(1000);
            toggleMessage = string.Empty;
            StateHasChanged();
            return;
        }

        isToggling = true;
        toggleMessage = string.Empty;
        lastToggleTime = DateTime.UtcNow;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("BlazorServer");
            var response = await httpClient.PostAsync("/api/featureflag/toggle", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ToggleResult>();
                if (result?.Success == true)
                {
                    toggleMessage = $"Toggle request successful: {result.Message}";
                    expectedFeatureFlagValue = result.NewValue;
                    propagationComplete = false;
                    
                    // Start cooldown period
                    isCooldown = true;
                    cooldownRemainingSeconds = CooldownSeconds;
                    StateHasChanged();
                    
                    // Countdown timer
                    for (int i = CooldownSeconds; i > 0; i--)
                    {
                        await Task.Delay(1000);
                        cooldownRemainingSeconds = i - 1;
                        StateHasChanged();
                    }
                    
                    isCooldown = false;
                    cooldownRemainingSeconds = 0;
                    toggleMessage = string.Empty;
                    
                    // Start polling for propagation
                    await StartPropagationPolling();
                }
                else
                {
                    toggleMessage = result?.Message ?? "Toggle failed";
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toggleMessage = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            toggleMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isToggling = false;
            StateHasChanged();
        }
    }

    private class MiniHealthStatus
    {
        public string AppConfigurationName { get; set; } = string.Empty;
        public bool AppConfigurationConfigured { get; set; }
        public string SentinelValue { get; set; } = string.Empty;
        public bool FeatureManagerAvailable { get; set; }
        public bool? FeatureFlagValue { get; set; }
        public string FeatureFlagDisplay { get; set; } = "Not tested";
        public string OutboxServiceStatus { get; set; } = "Not tested";
        public int OutboxPendingEventsCount { get; set; }
    }

    private async Task StartPropagationPolling()
    {
        if (expectedFeatureFlagValue == null)
        {
            return;
        }

        // Cancel any existing polling
        propagationCancellationTokenSource?.Cancel();
        propagationCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = propagationCancellationTokenSource.Token;

        isWaitingForPropagation = true;
        propagationComplete = false;
        propagationStatus = "Checking for change...";
        StateHasChanged();

        var startTime = DateTime.UtcNow;
        var pollCount = 0;

        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(PollingIntervalSeconds), cancellationToken);
                pollCount++;

                var elapsed = (DateTime.UtcNow - startTime).TotalSeconds;
                if (elapsed > MaxPropagationWaitSeconds)
                {
                    propagationStatus = $"Timeout after {MaxPropagationWaitSeconds} seconds. The change may still be propagating.";
                    isWaitingForPropagation = false;
                    StateHasChanged();
                    return;
                }

                // Reload health status
                await LoadMiniHealth();
                StateHasChanged();

                // Check if the feature flag value matches the expected value
                if (miniHealth?.FeatureFlagValue == expectedFeatureFlagValue)
                {
                    propagationComplete = true;
                    isWaitingForPropagation = false;
                    propagationStatus = $"Change detected after {elapsed:F1} seconds ({pollCount} checks)";
                    StateHasChanged();

                    // Auto-hide success message after 5 seconds
                    await Task.Delay(5000, cancellationToken);
                    propagationComplete = false;
                    expectedFeatureFlagValue = null;
                    StateHasChanged();
                    return;
                }
                else
                {
                    propagationStatus = $"Waiting... ({elapsed:F0}s elapsed, {pollCount} checks) - Current: {miniHealth?.FeatureFlagValue}, Expected: {expectedFeatureFlagValue}";
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Polling was cancelled, which is fine
            isWaitingForPropagation = false;
            propagationComplete = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            propagationStatus = $"Error during polling: {ex.Message}";
            isWaitingForPropagation = false;
            StateHasChanged();
        }
    }

    private class ToggleResult
    {
        public bool Success { get; set; }
        public bool? PreviousValue { get; set; }
        public bool? NewValue { get; set; }
        public string? SentinelValue { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        // Cancel any ongoing polling when component is disposed
        propagationCancellationTokenSource?.Cancel();
        if (propagationCancellationTokenSource != null)
        {
            await Task.Delay(100); // Give cancellation time to process
            propagationCancellationTokenSource.Dispose();
        }
    }
}


