@page "/inspector"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Inspector")]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Inspector Dashboard</PageTitle>

<div class="container">
    <h1>Inspector Dashboard</h1>
    
    @{
        var user = HttpContextAccessor.HttpContext?.User;
    }
    
    @if (user?.Identity?.IsAuthenticated == true)
    {
        <div class="user-info">
            <div class="user-info-text">
                <p><strong>Authenticated as:</strong> @user.Identity.Name</p>
                <p><strong>Role:</strong> @user.FindFirst(ClaimTypes.Role)?.Value</p>
            </div>
            <form method="post" action="/api/auth/logout" class="user-info-logout">
                <button type="submit" class="btn btn-secondary">Logout</button>
            </form>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>User Information:</strong> View user accounts. Modification is restricted to administrators.</p>
                <p style="color: var(--color-text-muted); font-size: 0.9em; margin-top: var(--spacing-sm);">
                    User viewing functionality will be implemented in a later step.
                </p>
            </div>
        </div>

        <hr class="section-divider" />

        <div class="dashboard-section">
            <div class="dashboard-expandable-section">
                <p><strong>Ticket Management:</strong> View and create tickets. Delete functionality is restricted to administrators.</p>
                <div class="button-container" style="margin-top: var(--spacing-md);">
                    <a href="/bookings" class="btn btn-primary">Go to Booking Management</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <p>Not authenticated. <a href="/login">Go to login page</a> to authenticate.</p>
    }
</div>


