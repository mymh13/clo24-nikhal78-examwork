@page "/health"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>System Health</PageTitle>

<div class="container">
    <h1>System Health Status</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="margin: 20px 0; padding: 15px; background: #ff6b6b; color: white; border-radius: 8px;">
            <h3>Error</h3>
            <p>@errorMessage</p>
            <p>API endpoint: /api/health</p>
        </div>
    }
    else if (healthStatus == null)
    {
        <p>Loading health status...</p>
    }
    else
    {
        <div style="margin: 20px 0;">
            <h3>Overall Status: <span style="color: @(healthStatus.Status == "Healthy" ? "#4ec9b0" : "#ff6b6b")">@healthStatus.Status</span></h3>
            <p><strong>Timestamp:</strong> @healthStatus.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
        </div>

        <div style="margin: 20px 0;">
            <h3>Configuration Status</h3>
            <div style="background: #1e1e1e; padding: 15px; border-radius: 8px; text-align: left;">
                <p><strong>Key Vault: </strong> 
                    @if (healthStatus.Configuration.KeyVaultConfigured)
                    {
                        <span style="color: #4ec9b0;">✓ Configured</span> <text>(@healthStatus.Configuration.KeyVaultName)</text>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not configured</span>
                    }
                </p>
                <p><strong>Cosmos DB Client: </strong> 
                    @if (healthStatus.Configuration.CosmosDbClientRegistered)
                    {
                        <span style="color: #4ec9b0;">✓ Registered</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not registered</span>
                    }
                </p>
                <p><strong>Cosmos DB Connection: </strong> 
                    @if (healthStatus.Configuration.CosmosDbConnectionStatus == "Connected")
                    {
                        <span style="color: #4ec9b0;">✓ @healthStatus.Configuration.CosmosDbConnectionStatus</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ @healthStatus.Configuration.CosmosDbConnectionStatus</span>
                    }
                </p>
                <p><strong>Application Insights: </strong> 
                    @if (healthStatus.Configuration.ApplicationInsightsConfigured)
                    {
                        <span style="color: #4ec9b0;">✓ Configured</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not configured</span>
                    }
                </p>
                <p><strong>App Configuration: </strong> 
                    @if (healthStatus.Configuration.AppConfigurationConfigured)
                    {
                        <span style="color: #4ec9b0;">✓ Configured</span> <text>(@healthStatus.Configuration.AppConfigurationName)</text>
                        @if (!string.IsNullOrEmpty(healthStatus.Configuration.SentinelValue) && healthStatus.Configuration.SentinelValue != "Not found")
                        {
                            <text> - Sentinel: @healthStatus.Configuration.SentinelValue</text>
                        }
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not configured</span>
                    }
                </p>
                <p><strong>Feature Manager: </strong> 
                    @if (healthStatus.Configuration.FeatureManagerAvailable)
                    {
                        <span style="color: #4ec9b0;">✓ Available</span>
                        @if (!string.IsNullOrEmpty(healthStatus.Configuration.FeatureFlagTest) && healthStatus.Configuration.FeatureFlagTest != "Not tested")
                        {
                            <text> - @healthStatus.Configuration.FeatureFlagTest</text>
                        }
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not available</span>
                    }
                </p>
                <p><strong>Outbox Service: </strong> 
                    @if (healthStatus.Configuration.OutboxServiceRegistered)
                    {
                        <span style="color: #4ec9b0;">✓ Registered</span>
                        @if (!string.IsNullOrEmpty(healthStatus.Configuration.OutboxServiceStatus) && healthStatus.Configuration.OutboxServiceStatus != "Not tested")
                        {
                            <text> - @healthStatus.Configuration.OutboxServiceStatus</text>
                            @if (healthStatus.Configuration.OutboxServiceStatus == "Operational")
                            {
                                <text> (@healthStatus.Configuration.OutboxPendingEventsCount pending events)</text>
                            }
                        }
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not registered</span>
                    }
                </p>
                <p><strong>Service Bus Client: </strong> 
                    @if (healthStatus.Configuration.ServiceBusClientRegistered)
                    {
                        <span style="color: #4ec9b0;">✓ Registered</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not registered</span>
                    }
                </p>
                <p><strong>Event Publisher: </strong> 
                    @if (healthStatus.Configuration.EventPublisherRegistered)
                    {
                        <span style="color: #4ec9b0;">✓ Registered</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not registered</span>
                    }
                </p>
                <p><strong>Service Bus Status: </strong> 
                    @if (healthStatus.Configuration.ServiceBusStatus == "Operational")
                    {
                        <span style="color: #4ec9b0;">✓ @healthStatus.Configuration.ServiceBusStatus</span>
                        @if (!string.IsNullOrEmpty(healthStatus.Configuration.ServiceBusQueueName))
                        {
                            <text> (Queue: @healthStatus.Configuration.ServiceBusQueueName)</text>
                        }
                    }
                    else if (!string.IsNullOrEmpty(healthStatus.Configuration.ServiceBusStatus) && healthStatus.Configuration.ServiceBusStatus != "Not tested")
                    {
                        <span style="color: #ff6b6b;">✗ @healthStatus.Configuration.ServiceBusStatus</span>
                    }
                    else
                    {
                        <span style="color: #ff6b6b;">✗ Not tested</span>
                    }
                </p>
            </div>
        </div>

        <div style="margin-top: 20px;">
            <a href="/" class="back-link">← Back to Home</a>
        </div>
    }
</div>

@code {
    private HealthStatus? healthStatus;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("/api/health");
            if (response.IsSuccessStatusCode)
            {
                healthStatus = await response.Content.ReadFromJsonAsync<HealthStatus>();
            }
            else
            {
                errorMessage = $"API returned status {response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading health status: {ex.Message}";
        }
    }

    private class HealthStatus
    {
        public string Status { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public ConfigurationStatus Configuration { get; set; } = new();
    }

    private class ConfigurationStatus
    {
        public string KeyVaultName { get; set; } = string.Empty;
        public bool KeyVaultConfigured { get; set; }
        public bool CosmosDbClientRegistered { get; set; }
        public string CosmosDbConnectionStatus { get; set; } = string.Empty;
        public bool ApplicationInsightsConfigured { get; set; }
        public string AppConfigurationEndpoint { get; set; } = string.Empty;
        public string AppConfigurationName { get; set; } = string.Empty;
        public bool AppConfigurationConfigured { get; set; }
        public string SentinelValue { get; set; } = string.Empty;
        public bool FeatureManagerAvailable { get; set; }
        public bool? FeatureFlagValue { get; set; }
        public string FeatureFlagTest { get; set; } = string.Empty;
        public bool OutboxServiceRegistered { get; set; }
        public string OutboxServiceStatus { get; set; } = string.Empty;
        public int OutboxPendingEventsCount { get; set; }
        public bool ServiceBusClientRegistered { get; set; }
        public bool EventPublisherRegistered { get; set; }
        public string ServiceBusStatus { get; set; } = string.Empty;
        public string ServiceBusQueueName { get; set; } = string.Empty;
    }
}

